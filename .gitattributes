# Normalize line endings: LF in the repository and in working trees on every OS.
# Hook scripts and CI must see the same bytes on Windows, macOS and Linux.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
