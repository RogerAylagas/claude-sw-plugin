# {{PROJECT_NAME}} tasks. CI runs these same recipes; `just check` must pass before a PR.
# Requires VCPKG_ROOT to point at a vcpkg checkout (see CONTRIBUTING.md).
set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

# List recipes
default:
    @just --list

# Configure the build (installs dependencies with vcpkg) and the git hooks
setup:
    cmake --preset dev
    uvx pre-commit install

# Format code (clang-format)
fmt:
    uvx pre-commit run clang-format --all-files

# All pre-commit hooks on all files (clang-format, file checks, secrets)
lint:
    uvx pre-commit run --all-files --show-diff-on-failure

# Static analysis (clang-tidy on the project's sources, warnings are errors)
analyze:
    cmake --preset tidy
    cmake --build --preset tidy

# Debug build
build:
    cmake --preset dev
    cmake --build --preset dev

# Unit tests
test: build
    ctest --preset unit

# Integration tests
test-integration: build
    ctest --preset integration

# Build and run all tests with AddressSanitizer and UndefinedBehaviorSanitizer (GCC/Clang)
sanitize:
    cmake --preset asan
    cmake --build --preset asan
    ctest --preset asan

# Everything CI runs (CI also runs `sanitize`)
check: lint analyze build test test-integration
