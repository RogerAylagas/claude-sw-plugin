# {{PROJECT_NAME}} tasks. CI runs these same recipes; `just check` must pass before a PR.
set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

# List recipes
default:
    @just --list

# Install the toolchain from rust-toolchain.toml and the git hooks (run once after cloning)
setup:
    rustup toolchain install
    uvx --exclude-newer "14 days" pre-commit install

# Format code
fmt:
    cargo fmt --all

# All pre-commit hooks on all files (rustfmt, file checks, secrets)
lint:
    uvx --exclude-newer "14 days" pre-commit run --all-files --show-diff-on-failure

# Static analysis (clippy, warnings are errors)
analyze:
    cargo clippy --all-targets --all-features --locked -- -D warnings

# Build every target
build:
    cargo build --all-targets --locked

# Unit tests (the #[cfg(test)] modules in src/)
test:
    cargo test --lib --locked  # sw:if kind=lib
    cargo test --doc --locked  # sw:if kind=lib
    cargo test --bins --locked  # sw:if kind=app

# Integration tests (tests/*.rs)
test-integration:
    cargo test --test '*' --locked

# Everything CI runs
check: lint analyze build test test-integration
